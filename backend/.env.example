# Server Port
PORT=5000

# MongoDB URI (Replace with your actual connection URL)
MONGODB_URI=mongodb://127.0.0.1:27017/auth-backend

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=30d

# Mail Settings (Optional - if left blank, reset password link will be logged to console)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@authbackend.com
FROM_NAME=AuthBackend
